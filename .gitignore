# Godot's import cache, regenerated on first run.
.godot/

# Written per launch by run_bench.sh / the launcher to select the physics engine.
override.cfg

# Benchmark output.
results/
results-threshold/
*.log

# Regenerated by make_pdf.py; large and changes every run.
docs/REPORT.html
.DS_Store

# Copies Godot makes of loaded extension DLLs on Windows.
~*.dll
